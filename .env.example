# Postgres connection string (CapRover one-click Postgres: srv-captain--<app-name>)
DATABASE_URL=postgres://rackmap:change-me@srv-captain--rackmap-db:5432/rackmap
# Long random string used to sign session cookies (openssl rand -hex 32)
SESSION_SECRET=
# Port the Express server listens on (CapRover default container HTTP port is 80)
PORT=3000
# Set to "true" when served over HTTPS (behind Nginx Proxy Manager). Controls the Secure cookie flag.
COOKIE_SECURE=true
# Directory for nightly JSON backups (mount a persistent volume here)
BACKUP_DIR=/data/backups
# Number of days of nightly backups to keep
BACKUP_RETENTION_DAYS=14
# Local dev only: use embedded PGlite instead of Postgres when DATABASE_URL is unset
# PGLITE_DIR=./data/pglite
